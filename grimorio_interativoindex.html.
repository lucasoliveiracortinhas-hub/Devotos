<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Grimório Violeta do Caos</title>
<style>
:root{--bg:#160d25;--panel:#241438;--panel2:#301b49;--line:#67438b;--ink:#f6efff;--muted:#c8b6dc;--accent:#c59aff;--accent2:#8f5bd1;--gold:#e7cb93}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#38204f 0,#160d25 55%);color:var(--ink);font-family:Georgia,'Times New Roman',serif;min-height:100vh}.app{max-width:1000px;margin:auto;padding:18px}.hero{border:1px solid var(--line);border-radius:18px;padding:25px;background:linear-gradient(135deg,#38204f,#1e1230);text-align:center;box-shadow:0 12px 36px #0005}.sigil{font-size:32px;color:var(--gold)}h1{margin:7px 0;color:#e2c5ff;font-size:clamp(27px,5vw,42px)}.sub{color:var(--muted)}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:16px 0}.toolbar input{flex:1;min-width:180px}.field,input,select,textarea{background:#160e23;color:var(--ink);border:1px solid var(--line);border-radius:9px;padding:11px;font:inherit}button{cursor:pointer;border:1px solid #8e65b6;border-radius:9px;background:#4b2c6c;color:white;padding:10px 13px;font:inherit}button:hover{background:#68418e}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:15px}.tabs button{background:#241438}.tabs button.active{background:#8b58c1;border-color:#d9b7ff}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:11px}.spell{background:linear-gradient(135deg,#2b1940,#211331);border:1px solid var(--line);border-radius:13px;padding:15px;text-align:left;min-height:105px}.spell strong{display:block;color:#e5caff;font-size:18px;margin-bottom:8px}.tag{font:12px Arial,sans-serif;color:var(--gold);letter-spacing:.04em;text-transform:uppercase}.muted{color:var(--muted)}.page{background:#f3e8d4;color:#382448;border:7px double #9e7cba;border-radius:13px;padding:22px;box-shadow:0 15px 35px #0005}.page h2{color:#4c2872;margin-top:0}.page .muted{color:#665477}.page button{margin:4px}.detailgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:9px;margin:15px 0}.detailgrid div{background:#e6d7ef;border-radius:8px;padding:10px}.detailgrid b{display:block;font:12px Arial,sans-serif;text-transform:uppercase;color:#76548f;margin-bottom:5px}.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}.formgrid label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font-size:14px}.formgrid .wide{grid-column:1/-1}textarea{min-height:95px;resize:vertical}.note{font:13px Arial,sans-serif;color:var(--muted);margin-top:18px}.hidden{display:none!important}.actions{display:flex;flex-wrap:wrap;gap:8px;margin:15px 0}@media(max-width:520px){.app{padding:10px}.hero{padding:18px}.page{padding:14px}}
</style></head><body><main class="app"><header class="hero"><div class="sigil">✧ ☾ ✧</div><h1>Grimório Violeta do Caos</h1><div class="sub">Feiticeiro 7 · Bardo 1 · Magia Selvagem</div><p class="muted">“Toda magia tem um preço; nem todo preço é conhecido.”</p></header>
<div class="toolbar"><input id="search" placeholder="⌕ Buscar magia ou efeito…"><button id="add">＋ Magia caseira</button><button id="export">Exportar caseiras</button><button id="importBtn">Importar caseiras</button><input id="importFile" type="file" accept="application/json" class="hidden"></div>
<div id="tabs" class="tabs"></div><section id="list" class="grid"></section><section id="detail" class="page hidden"></section><section id="editor" class="page hidden"><h2 id="formTitle">Criar magia caseira</h2><form id="spellForm"><input type="hidden" id="editId"><div class="formgrid"><label>Nome<input id="name" required maxlength="80"></label><label>Categoria<select id="category"><option>Truque</option><option>1º Círculo</option><option>2º Círculo</option><option>3º Círculo</option><option>4º Círculo</option><option>5º Círculo</option><option>6º Círculo</option><option>7º Círculo</option><option>8º Círculo</option><option>9º Círculo</option><option>Subclasse</option><option>Magia Selvagem</option><option>Bardo</option></select></label><label>Ação<input id="action" placeholder="Ação, reação, bônus…"></label><label>Alcance<input id="range" placeholder="Pessoal, toque, 18 m…"></label><label>Duração<input id="duration" placeholder="Instantânea, 1 minuto…"></label><label>Componentes<input id="components" placeholder="V, S, M…"></label><label>Dano / cura<input id="damage" placeholder="Ex.: 2d8 de dano…"></label><label>Custo / concentração<input id="cost" placeholder="Espaço, pontos, concentração…"></label><label class="wide">Resumo<textarea id="summary" placeholder="Uma frase para lembrar o efeito"></textarea></label><label class="wide">Descrição completa<textarea id="description" placeholder="Regras, testes, escalonamento e detalhes…"></textarea></label></div><div class="actions"><button type="submit">Salvar magia</button><button type="button" id="cancel">Cancelar</button></div></form></section>
<p class="note">As magias caseiras são guardadas neste navegador. Use “Exportar caseiras” para criar uma cópia de segurança e transferi-las para outro aparelho. Valores das magias oficiais devem ser conferidos no livro usado pela mesa; esta ficha é adaptável ao sistema da campanha.</p></main>
<script>
const base=[
['Ataque Certeiro','Truque','Aponta uma abertura nas defesas do alvo, preparando um ataque mais preciso.'],['Estouro Mágico','Truque','Libera energia mágica contra um alvo. Confira o dano e o tipo usados na sua mesa.'],['Prestidigitação','Truque','Produz pequenos efeitos mágicos sensoriais e truques inofensivos.'],['Proteção contra Lâmina','Truque','Uma proteção mágica dificulta que ataques atinjam você.'],['Toque Chocante','Truque','Um toque descarrega eletricidade no alvo.'],['Raio de Gelo','Truque','Um raio gelado causa dano de frio e pode reduzir o deslocamento.'],['Amizade','Truque','Influencia temporariamente a atitude de uma criatura, conforme as regras da mesa.'],['Armadura Arcana','1º Círculo','Uma proteção mágica envolve uma criatura desprotegida.'],['Salto','1º Círculo','Aumenta a capacidade de salto do alvo.'],['Recuo Acelerado','1º Círculo','Permite deslocamentos rápidos enquanto mantém a magia.'],['Mísseis Mágicos','1º Círculo','Projéteis de força atingem alvos escolhidos. Referência 2024: cada projétil causa 1d4 + 1 de dano de Força.'],['Palavra Curativa','1º Círculo','Uma palavra breve restaura pontos de vida à distância.'],['Toque de Cura','1º Círculo','Um toque canaliza energia restauradora.'],['Aprimorar Habilidade','2º Círculo','Concede benefício mágico relacionado a uma habilidade.'],['Coroa da Loucura','2º Círculo','Uma influência mágica perturba o comportamento do alvo.'],['Reflexos','2º Círculo','Cria duplicatas ilusórias que confundem ataques.'],['Contramagia','3º Círculo','Interrompe uma magia em processo de conjuração.'],['Dissipar Magia','3º Círculo','Encerra efeitos mágicos ativos conforme a dificuldade aplicável.'],['Medo','3º Círculo','Projeta uma imagem aterradora que pode amedrontar criaturas.'],['Banimento','4º Círculo','Tenta enviar uma criatura para outro plano de existência.'],['Orbe Cromático','Subclasse','Uma esfera de energia causa dano de um tipo escolhido. Referência 2024: 3d8 de dano.'],['Leque Cromático','Subclasse','Um leque de luzes coloridas afeta criaturas em uma área.'],['Aumentar/Reduzir','Subclasse','Altera magicamente o tamanho de uma criatura ou objeto.'],['Piscar','Subclasse','Você pode desaparecer temporariamente do plano atual e reaparecer.'],['Lentidão','Subclasse','Reduz a velocidade e limita as ações de criaturas afetadas.'],['Metamorfose','Subclasse','Transforma uma criatura em outra forma permitida pela magia.'],['Confusão','Subclasse','Embaralha as ações de criaturas em uma área.'],['Magia Selvagem','Magia Selvagem','Sua magia pode desencadear efeitos imprevisíveis. Insira aqui a tabela própria da campanha.'],['Inspiração de Bardo','Bardo','Inspira uma criatura aliada, concedendo um dado ou benefício definido pela mesa.']
].map((x,i)=>({id:'base'+i,name:x[0],category:x[1],summary:x[2],action:'Conforme a versão usada na mesa',range:'Conferir livro',duration:'Conferir livro',components:'Conferir livro',damage:'Ver descrição',cost:'Conferir livro',description:x[2],home:false}));
let custom=[];try{custom=JSON.parse(localStorage.getItem('grimorioCustom')||'[]')}catch(e){}let category='Tudo',selected=null;
const $=id=>document.getElementById(id);const all=()=>[...base,...custom];const cats=['Tudo',...new Set(base.map(s=>s.category)),'Caseiras'];
function save(){try{localStorage.setItem('grimorioCustom',JSON.stringify(custom))}catch(e){alert('O navegador não permitiu salvar. Exporte suas magias para não perdê-las.')}}
function renderTabs(){$('tabs').innerHTML=cats.map(c=>`<button class="${category===c?'active':''}" data-cat="${c}">${c}</button>`).join('');$('tabs').querySelectorAll('button').forEach(b=>b.onclick=()=>{category=b.dataset.cat;render()})}
function render(){renderTabs();let q=$('search').value.toLowerCase();let arr=all().filter(s=>(category==='Tudo'||(category==='Caseiras'?s.home:s.category===category))&&(`${s.name} ${s.summary} ${s.description}`.toLowerCase().includes(q)));$('list').classList.remove('hidden');$('detail').classList.add('hidden');$('editor').classList.add('hidden');$('list').innerHTML=arr.length?arr.map(s=>`<button class="spell" data-id="${s.id}"><span class="tag">${s.home?'✦ Caseira · ':''}${s.category}</span><strong>${esc(s.name)}</strong><span class="muted">${esc(s.summary||'Sem resumo')}</span></button>`).join(''):'<p class="muted">Nenhuma magia encontrada nesta categoria.</p>';$('list').querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>showDetail(b.dataset.id))}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showDetail(id){selected=all().find(s=>s.id===id);if(!selected)return;$('list').classList.add('hidden');$('editor').classList.add('hidden');$('detail').classList.remove('hidden');let s=selected;$('detail').innerHTML=`<div class="tag">${s.home?'✦ Magia caseira · ':''}${esc(s.category)}</div><h2>✧ ${esc(s.name)}</h2><p>${esc(s.summary||'')}</p><div class="detailgrid">${[['Ação',s.action],['Alcance',s.range],['Duração',s.duration],['Componentes',s.components],['Dano / cura',s.damage],['Custo / concentração',s.cost]].map(([k,v])=>`<div><b>${k}</b>${esc(v||'Não definido')}</div>`).join('')}</div><h3>Descrição e regras</h3><p style="white-space:pre-wrap;line-height:1.6">${esc(s.description||'Nenhuma descrição adicional.')}</p><div class="actions"><button id="back">← Voltar ao grimório</button>${s.home?'<button id="edit">Editar</button><button id="delete">Excluir</button>':''}</div>`;$('back').onclick=render;if(s.home){$('edit').onclick=()=>openEditor(s);$('delete').onclick=()=>{if(confirm('Excluir esta magia caseira?')){custom=custom.filter(x=>x.id!==s.id);save();render()}}}}
function openEditor(s=null){$('list').classList.add('hidden');$('detail').classList.add('hidden');$('editor').classList.remove('hidden');$('formTitle').textContent=s?'Editar magia caseira':'Criar magia caseira';$('spellForm').reset();$('editId').value=s?.id||'';if(s)for(const k of ['name','category','action','range','duration','components','damage','cost','summary','description'])$(k).value=s[k]||''}
$('add').onclick=()=>openEditor();$('cancel').onclick=render;$('search').oninput=render;$('spellForm').onsubmit=e=>{e.preventDefault();let id=$('editId').value;let s={id:id||'custom'+Date.now(),home:true};for(const k of ['name','category','action','range','duration','components','damage','cost','summary','description'])s[k]=$(k).value.trim();if(id)custom=custom.map(x=>x.id===id?s:x);else custom.push(s);save();category='Caseiras';render();showDetail(s.id)};
$('export').onclick=()=>{let blob=new Blob([JSON.stringify(custom,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='minhas-magias-caseiras.json';a.click();URL.revokeObjectURL(url)};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let data=JSON.parse(await f.text());if(!Array.isArray(data))throw Error();let valid=data.filter(s=>s&&s.name&&s.category).map(s=>({...s,id:'custom'+Date.now()+Math.random().toString(16).slice(2),home:true}));custom.push(...valid);save();category='Caseiras';render();alert(`${valid.length} magia(s) importada(s).`)}catch(err){alert('Não consegui ler esse arquivo JSON de magias.')}e.target.value=''};
render();
</script></body></html>
